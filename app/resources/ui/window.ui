<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="ScreenForgeWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="yes">ScreenForge</property>
    <property name="default-width">1100</property>
    <property name="default-height">700</property>
    <property name="width-request">360</property>
    <property name="height-request">400</property>
    <child>
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <child type="start">
              <object class="GtkMenuButton" id="open_menu_button">
                <property name="icon-name">document-open-symbolic</property>
                <property name="tooltip-text" translatable="yes">Öffnen</property>
                <property name="menu-model">open_menu</property>
              </object>
            </child>
            <child type="start">
              <object class="GtkButton" id="undo_button">
                <property name="icon-name">edit-undo-symbolic</property>
                <property name="tooltip-text" translatable="yes">Rückgängig (Strg+Z)</property>
                <property name="action-name">win.undo</property>
              </object>
            </child>
            <child type="start">
              <object class="GtkButton" id="redo_button">
                <property name="icon-name">edit-redo-symbolic</property>
                <property name="tooltip-text" translatable="yes">Wiederholen (Strg+Umschalt+Z)</property>
                <property name="action-name">win.redo</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkToggleButton" id="hide_screenshots_button">
                <property name="icon-name">view-reveal-symbolic</property>
                <property name="tooltip-text" translatable="yes">Screenshots vorübergehend ausblenden</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton" id="export_button">
                <property name="label" translatable="yes">Exportieren</property>
                <property name="action-name">win.export</property>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>
            <child type="end">
              <object class="GtkMenuButton" id="zoom_menu_button">
                <property name="icon-name">zoom-fit-best-symbolic</property>
                <property name="tooltip-text" translatable="yes">Zoom</property>
                <property name="menu-model">zoom_menu</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkMenuButton" id="primary_menu_button">
                <property name="icon-name">open-menu-symbolic</property>
                <property name="tooltip-text" translatable="yes">Hauptmenü</property>
                <property name="menu-model">primary_menu</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwToastOverlay" id="toast_overlay">
            <child>
              <object class="AdwOverlaySplitView" id="split_view">
            <property name="sidebar-width-fraction">0.28</property>
            <property name="min-sidebar-width">240</property>
            <property name="max-sidebar-width">360</property>
            <child type="sidebar">
              <object class="GtkScrolledWindow">
                <property name="hscrollbar-policy">never</property>
                <child>
                  <object class="AdwPreferencesPage">
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">Layout</property>
                        <child>
                          <object class="AdwComboRow" id="layout_mode_row">
                            <property name="title" translatable="yes">Art</property>
                            <property name="model">
                              <object class="GtkStringList">
                                <items>
                                  <item translatable="yes">Horizontal</item>
                                  <item translatable="yes">Vertikal</item>
                                  <item translatable="yes">Raster</item>
                                  <item translatable="yes">Frei</item>
                                </items>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="spacing_row">
                            <property name="title" translatable="yes">Abstand</property>
                            <property name="subtitle" translatable="yes">Zwischen den Screenshots, in Pixeln</property>
                            <property name="digits">0</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">500</property>
                                <property name="step-increment">4</property>
                                <property name="page-increment">20</property>
                                <property name="value">24</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="margin_row">
                            <property name="title" translatable="yes">Außenrand</property>
                            <property name="subtitle" translatable="yes">Rand um die Komposition, in Pixeln</property>
                            <property name="digits">0</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">500</property>
                                <property name="step-increment">4</property>
                                <property name="page-increment">20</property>
                                <property name="value">48</property>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup" id="background_group">
                        <property name="title" translatable="yes">Hintergrund</property>
                        <child>
                          <object class="AdwComboRow" id="background_type_row">
                            <property name="title" translatable="yes">Art</property>
                            <property name="model">
                              <object class="GtkStringList">
                                <items>
                                  <item translatable="yes">Einfarbig</item>
                                  <item translatable="yes">Linearer Verlauf</item>
                                  <item translatable="yes">Radialer Verlauf</item>
                                  <item translatable="yes">Bild</item>
                                  <item translatable="yes">Generiert</item>
                                </items>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="background_color1_row">
                            <property name="title" translatable="yes">Farbe 1</property>
                            <child type="suffix">
                              <object class="GtkColorDialogButton" id="background_color_button">
                                <property name="valign">center</property>
                                <property name="dialog">
                                  <object class="GtkColorDialog"/>
                                </property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="gradient_color2_row">
                            <property name="title" translatable="yes">Farbe 2</property>
                            <property name="visible">false</property>
                            <child type="suffix">
                              <object class="GtkColorDialogButton" id="gradient_color2_button">
                                <property name="valign">center</property>
                                <property name="dialog">
                                  <object class="GtkColorDialog"/>
                                </property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="gradient_angle_row">
                            <property name="title" translatable="yes">Winkel</property>
                            <property name="subtitle" translatable="yes">In Grad</property>
                            <property name="visible">false</property>
                            <property name="digits">0</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">360</property>
                                <property name="step-increment">15</property>
                                <property name="page-increment">45</property>
                                <property name="value">90</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="gradient_auto_colors_row">
                            <property name="title" translatable="yes">Automatische Farben</property>
                            <property name="subtitle" translatable="yes">Aus den importierten Screenshots vorschlagen — erneut klicken für einen anderen Vorschlag</property>
                            <property name="visible">false</property>
                            <child type="suffix">
                              <object class="GtkButton" id="gradient_generate_button">
                                <property name="valign">center</property>
                                <property name="label" translatable="yes">Generieren</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="background_image_row">
                            <property name="title" translatable="yes">Bilddatei</property>
                            <property name="subtitle" translatable="yes">Kein Bild ausgewählt</property>
                            <property name="visible">false</property>
                            <child type="suffix">
                              <object class="GtkButton" id="background_image_button">
                                <property name="valign">center</property>
                                <property name="label" translatable="yes">Wählen…</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwComboRow" id="background_image_fit_row">
                            <property name="title" translatable="yes">Passung</property>
                            <property name="visible">false</property>
                            <property name="model">
                              <object class="GtkStringList">
                                <items>
                                  <item translatable="yes">Ausfüllen (zuschneiden)</item>
                                  <item translatable="yes">Einpassen</item>
                                  <item translatable="yes">Strecken</item>
                                  <item translatable="yes">Kacheln</item>
                                </items>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="background_image_opacity_row">
                            <property name="title" translatable="yes">Deckkraft</property>
                            <property name="subtitle" translatable="yes">In Prozent</property>
                            <property name="visible">false</property>
                            <property name="digits">0</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">100</property>
                                <property name="step-increment">5</property>
                                <property name="page-increment">20</property>
                                <property name="value">100</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwComboRow" id="generator_color_strategy_row">
                            <property name="title" translatable="yes">Farben</property>
                            <property name="visible">false</property>
                            <property name="model">
                              <object class="GtkStringList">
                                <items>
                                  <item translatable="yes">Manuell</item>
                                  <item translatable="yes">Von Screenshots</item>
                                  <item translatable="yes">Schwarz-Weiß</item>
                                  <item translatable="yes">Zufällig</item>
                                </items>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="generator_manual_color_row_1">
                            <property name="title" translatable="yes">Farbe 1</property>
                            <property name="visible">false</property>
                            <child type="suffix">
                              <object class="GtkColorDialogButton" id="generator_manual_color_button_1">
                                <property name="valign">center</property>
                                <property name="dialog">
                                  <object class="GtkColorDialog"/>
                                </property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="generator_manual_color_row_2">
                            <property name="title" translatable="yes">Farbe 2</property>
                            <property name="visible">false</property>
                            <child type="suffix">
                              <object class="GtkColorDialogButton" id="generator_manual_color_button_2">
                                <property name="valign">center</property>
                                <property name="dialog">
                                  <object class="GtkColorDialog"/>
                                </property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="generator_manual_color_row_3">
                            <property name="title" translatable="yes">Farbe 3</property>
                            <property name="visible">false</property>
                            <child type="suffix">
                              <object class="GtkColorDialogButton" id="generator_manual_color_button_3">
                                <property name="valign">center</property>
                                <property name="dialog">
                                  <object class="GtkColorDialog"/>
                                </property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="generator_manual_color_row_4">
                            <property name="title" translatable="yes">Farbe 4</property>
                            <property name="visible">false</property>
                            <child type="suffix">
                              <object class="GtkColorDialogButton" id="generator_manual_color_button_4">
                                <property name="valign">center</property>
                                <property name="dialog">
                                  <object class="GtkColorDialog"/>
                                </property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSwitchRow" id="generator_adapt_row">
                            <property name="title" translatable="yes">An Screenshots anpassen</property>
                            <property name="subtitle" translatable="yes">Farben und Platzierung berücksichtigen die Screenshots</property>
                            <property name="visible">false</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="generator_inverse_contrast_row">
                            <property name="title" translatable="yes">Invertierter Kontrast</property>
                            <property name="subtitle" translatable="yes">In Prozent — nur bei "Von Screenshots": höher wirkt stärker gegensätzlich/komplementär statt ähnlich</property>
                            <property name="visible">false</property>
                            <property name="digits">0</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">100</property>
                                <property name="step-increment">5</property>
                                <property name="page-increment">20</property>
                                <property name="value">50</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="generator_corner_bias_row">
                            <property name="title" translatable="yes">Fokus</property>
                            <property name="subtitle" translatable="yes">In Prozent — 0 % Wellenbänder, 100 % Eckbögen</property>
                            <property name="visible">false</property>
                            <property name="digits">0</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">100</property>
                                <property name="step-increment">5</property>
                                <property name="page-increment">20</property>
                                <property name="value">50</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="generator_offset_x_row">
                            <property name="title" translatable="yes">Position X</property>
                            <property name="subtitle" translatable="yes">In Prozent — verschiebt das Muster horizontal</property>
                            <property name="visible">false</property>
                            <property name="digits">0</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">-100</property>
                                <property name="upper">100</property>
                                <property name="step-increment">5</property>
                                <property name="page-increment">20</property>
                                <property name="value">0</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="generator_offset_y_row">
                            <property name="title" translatable="yes">Position Y</property>
                            <property name="subtitle" translatable="yes">In Prozent — verschiebt das Muster vertikal</property>
                            <property name="visible">false</property>
                            <property name="digits">0</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">-100</property>
                                <property name="upper">100</property>
                                <property name="step-increment">5</property>
                                <property name="page-increment">20</property>
                                <property name="value">0</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="generator_scale_row">
                            <property name="title" translatable="yes">Skalierung</property>
                            <property name="subtitle" translatable="yes">In Prozent — vergrößert oder verkleinert das Muster</property>
                            <property name="visible">false</property>
                            <property name="digits">0</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">40</property>
                                <property name="upper">250</property>
                                <property name="step-increment">10</property>
                                <property name="page-increment">50</property>
                                <property name="value">100</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="generator_contrast_row">
                            <property name="title" translatable="yes">Kontrast</property>
                            <property name="visible">false</property>
                            <property name="digits">0</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">100</property>
                                <property name="step-increment">5</property>
                                <property name="page-increment">20</property>
                                <property name="value">50</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="generator_seed_row">
                            <property name="title" translatable="yes">Seed</property>
                            <property name="subtitle" translatable="yes">Für reproduzierbare Ergebnisse</property>
                            <property name="visible">false</property>
                            <property name="digits">0</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">999999999</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">1000</property>
                                <property name="value">1</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="generator_generate_row">
                            <property name="title" translatable="yes">Hintergrund generieren</property>
                            <property name="subtitle" translatable="yes">Erneut klicken für eine neue Variante</property>
                            <property name="visible">false</property>
                            <child type="suffix">
                              <object class="GtkButton" id="generator_generate_button">
                                <property name="valign">center</property>
                                <property name="label" translatable="yes">Generieren</property>
                                <style>
                                  <class name="suggested-action"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">Effekte</property>
                        <child>
                          <object class="AdwComboRow" id="shadow_row">
                            <property name="title" translatable="yes">Schatten</property>
                            <property name="model">
                              <object class="GtkStringList">
                                <items>
                                  <item translatable="yes">Kein Schatten</item>
                                  <item translatable="yes">Subtil</item>
                                  <item translatable="yes">Standard</item>
                                  <item translatable="yes">Stark</item>
                                  <item translatable="yes">Floating</item>
                                </items>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="shadow_angle_row">
                            <property name="title" translatable="yes">Schatten-Winkel</property>
                            <property name="subtitle" translatable="yes">Richtung des Schattenwurfs, in Grad</property>
                            <property name="digits">0</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">360</property>
                                <property name="step-increment">5</property>
                                <property name="page-increment">45</property>
                                <property name="value">90</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="shadow_distance_row">
                            <property name="title" translatable="yes">Schatten-Distanz</property>
                            <property name="subtitle" translatable="yes">Länge des Schattenwurfs, in Pixeln</property>
                            <property name="digits">0</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">300</property>
                                <property name="step-increment">2</property>
                                <property name="page-increment">20</property>
                                <property name="value">6</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="shadow_blur_row">
                            <property name="title" translatable="yes">Weichzeichner</property>
                            <property name="subtitle" translatable="yes">Unschärfe des Schattens, in Pixeln</property>
                            <property name="digits">0</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">150</property>
                                <property name="step-increment">2</property>
                                <property name="page-increment">10</property>
                                <property name="value">16</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="corner_radius_row">
                            <property name="title" translatable="yes">Eckenradius</property>
                            <property name="subtitle" translatable="yes">In Pixeln</property>
                            <property name="digits">0</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">200</property>
                                <property name="step-increment">2</property>
                                <property name="page-increment">10</property>
                                <property name="value">0</property>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">Titel</property>
                        <property name="description" translatable="yes">Eine Überschrift über der gesamten Komposition</property>
                        <child>
                          <object class="AdwSwitchRow" id="title_enabled_row">
                            <property name="title" translatable="yes">Titel anzeigen</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwEntryRow" id="title_content_row">
                            <property name="title" translatable="yes">Text</property>
                            <property name="sensitive">false</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwComboRow" id="title_position_mode_row">
                            <property name="title" translatable="yes">Position</property>
                            <property name="sensitive">false</property>
                            <property name="model">
                              <object class="GtkStringList">
                                <items>
                                  <item translatable="yes">Automatisch</item>
                                  <item translatable="yes">Manuell (X/Y)</item>
                                </items>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwComboRow" id="title_horizontal_row">
                            <property name="title" translatable="yes">Horizontal</property>
                            <property name="sensitive">false</property>
                            <property name="model">
                              <object class="GtkStringList">
                                <items>
                                  <item translatable="yes">Links</item>
                                  <item translatable="yes">Mitte</item>
                                  <item translatable="yes">Rechts</item>
                                </items>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwComboRow" id="title_vertical_row">
                            <property name="title" translatable="yes">Vertikal</property>
                            <property name="sensitive">false</property>
                            <property name="model">
                              <object class="GtkStringList">
                                <items>
                                  <item translatable="yes">Oben</item>
                                  <item translatable="yes">Mitte</item>
                                  <item translatable="yes">Unten</item>
                                </items>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="title_padding_row">
                            <property name="title" translatable="yes">Randabstand</property>
                            <property name="subtitle" translatable="yes">In Pixeln</property>
                            <property name="sensitive">false</property>
                            <property name="digits">0</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">500</property>
                                <property name="step-increment">4</property>
                                <property name="page-increment">20</property>
                                <property name="value">32</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="title_x_row">
                            <property name="title" translatable="yes">X-Position</property>
                            <property name="subtitle" translatable="yes">In Pixeln, von links</property>
                            <property name="visible">false</property>
                            <property name="digits">0</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">8000</property>
                                <property name="step-increment">4</property>
                                <property name="page-increment">40</property>
                                <property name="value">48</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="title_y_row">
                            <property name="title" translatable="yes">Y-Position</property>
                            <property name="subtitle" translatable="yes">In Pixeln, von oben</property>
                            <property name="visible">false</property>
                            <property name="digits">0</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">8000</property>
                                <property name="step-increment">4</property>
                                <property name="page-increment">40</property>
                                <property name="value">24</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwComboRow" id="title_background_row">
                            <property name="title" translatable="yes">Hintergrund</property>
                            <property name="sensitive">false</property>
                            <property name="model">
                              <object class="GtkStringList">
                                <items>
                                  <item translatable="yes">Kein Hintergrund</item>
                                  <item translatable="yes">Einfarbig</item>
                                  <item translatable="yes">Verlauf</item>
                                </items>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="title_background_color_row">
                            <property name="title" translatable="yes">Hintergrundfarbe</property>
                            <property name="subtitle" translatable="yes">Deckkraft über die Farbwahl einstellbar</property>
                            <property name="visible">false</property>
                            <child type="suffix">
                              <object class="GtkColorDialogButton" id="title_background_color_button">
                                <property name="valign">center</property>
                                <property name="dialog">
                                  <object class="GtkColorDialog">
                                    <property name="with-alpha">true</property>
                                  </object>
                                </property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="title_background_color2_row">
                            <property name="title" translatable="yes">Hintergrundfarbe 2</property>
                            <property name="visible">false</property>
                            <child type="suffix">
                              <object class="GtkColorDialogButton" id="title_background_color2_button">
                                <property name="valign">center</property>
                                <property name="dialog">
                                  <object class="GtkColorDialog">
                                    <property name="with-alpha">true</property>
                                  </object>
                                </property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="title_corner_radius_row">
                            <property name="title" translatable="yes">Eckenradius</property>
                            <property name="sensitive">false</property>
                            <property name="digits">0</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">200</property>
                                <property name="step-increment">2</property>
                                <property name="page-increment">10</property>
                                <property name="value">0</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="title_font_row">
                            <property name="title" translatable="yes">Schrift</property>
                            <property name="sensitive">false</property>
                            <child type="suffix">
                              <object class="GtkFontDialogButton" id="title_font_button">
                                <property name="valign">center</property>
                                <property name="dialog">
                                  <object class="GtkFontDialog"/>
                                </property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwComboRow" id="title_alignment_row">
                            <property name="title" translatable="yes">Textausrichtung</property>
                            <property name="subtitle" translatable="yes">Bei mehrzeiligem Text</property>
                            <property name="sensitive">false</property>
                            <property name="model">
                              <object class="GtkStringList">
                                <items>
                                  <item translatable="yes">Links</item>
                                  <item translatable="yes">Mitte</item>
                                  <item translatable="yes">Rechts</item>
                                </items>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="title_letter_spacing_row">
                            <property name="title" translatable="yes">Zeichenabstand</property>
                            <property name="subtitle" translatable="yes">In Pixeln</property>
                            <property name="sensitive">false</property>
                            <property name="digits">1</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">-5</property>
                                <property name="upper">50</property>
                                <property name="step-increment">0.5</property>
                                <property name="page-increment">2</property>
                                <property name="value">0</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="title_line_spacing_row">
                            <property name="title" translatable="yes">Zeilenabstand</property>
                            <property name="subtitle" translatable="yes">Faktor, 1,0 = normal</property>
                            <property name="sensitive">false</property>
                            <property name="digits">2</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0.5</property>
                                <property name="upper">3</property>
                                <property name="step-increment">0.1</property>
                                <property name="page-increment">0.5</property>
                                <property name="value">1.2</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="title_color_row">
                            <property name="title" translatable="yes">Textfarbe</property>
                            <property name="sensitive">false</property>
                            <child type="suffix">
                              <object class="GtkColorDialogButton" id="title_color_button">
                                <property name="valign">center</property>
                                <property name="dialog">
                                  <object class="GtkColorDialog"/>
                                </property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="title_opacity_row">
                            <property name="title" translatable="yes">Deckkraft</property>
                            <property name="subtitle" translatable="yes">In Prozent</property>
                            <property name="sensitive">false</property>
                            <property name="digits">0</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">100</property>
                                <property name="step-increment">5</property>
                                <property name="page-increment">20</property>
                                <property name="value">100</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwComboRow" id="title_shadow_row">
                            <property name="title" translatable="yes">Schatten</property>
                            <property name="sensitive">false</property>
                            <property name="model">
                              <object class="GtkStringList">
                                <items>
                                  <item translatable="yes">Kein Schatten</item>
                                  <item translatable="yes">Subtil</item>
                                  <item translatable="yes">Standard</item>
                                  <item translatable="yes">Stark</item>
                                  <item translatable="yes">Floating</item>
                                </items>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="title_shadow_angle_row">
                            <property name="title" translatable="yes">Schatten-Winkel</property>
                            <property name="sensitive">false</property>
                            <property name="digits">0</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">360</property>
                                <property name="step-increment">5</property>
                                <property name="page-increment">45</property>
                                <property name="value">90</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="title_shadow_distance_row">
                            <property name="title" translatable="yes">Schatten-Distanz</property>
                            <property name="sensitive">false</property>
                            <property name="digits">0</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">300</property>
                                <property name="step-increment">2</property>
                                <property name="page-increment">20</property>
                                <property name="value">6</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="title_shadow_blur_row">
                            <property name="title" translatable="yes">Weichzeichner</property>
                            <property name="sensitive">false</property>
                            <property name="digits">0</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">150</property>
                                <property name="step-increment">2</property>
                                <property name="page-increment">10</property>
                                <property name="value">16</property>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">Export</property>
                        <child>
                          <object class="AdwSpinRow" id="export_width_row">
                            <property name="title" translatable="yes">Zielbreite</property>
                            <property name="subtitle" translatable="yes">Die Arbeitsfläche passt sich automatisch den Bildern an; hier wird nur die Ausgabegröße skaliert</property>
                            <property name="digits">0</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">100</property>
                                <property name="upper">8000</property>
                                <property name="step-increment">10</property>
                                <property name="page-increment">100</property>
                                <property name="value">1920</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="export_height_row">
                            <property name="title" translatable="yes">Höhe</property>
                            <property name="subtitle" translatable="yes">Automatisch, behält das Seitenverhältnis bei</property>
                            <property name="sensitive">false</property>
                            <property name="digits">0</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">1</property>
                                <property name="upper">100000</property>
                                <property name="step-increment">10</property>
                                <property name="page-increment">100</property>
                                <property name="value">1080</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwComboRow" id="export_format_row">
                            <property name="title" translatable="yes">Format</property>
                            <property name="model">
                              <object class="GtkStringList">
                                <items>
                                  <item>PNG</item>
                                  <item>JPEG</item>
                                  <item>WebP</item>
                                  <item>AVIF</item>
                                </items>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="export_quality_row">
                            <property name="title" translatable="yes">Qualität</property>
                            <property name="subtitle" translatable="yes">Nur für JPEG/WebP/AVIF</property>
                            <property name="digits">0</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">1</property>
                                <property name="upper">100</property>
                                <property name="step-increment">5</property>
                                <property name="page-increment">10</property>
                                <property name="value">90</property>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child type="content">
              <object class="GtkScrolledWindow">
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
                <child>
                  <object class="ScreenForgeCanvas" id="canvas">
                    <property name="hexpand">true</property>
                    <property name="vexpand">true</property>
                  </object>
                </child>
              </object>
            </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
  <menu id="open_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">Screenshots importieren…</attribute>
        <attribute name="action">win.open</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Projekt öffnen…</attribute>
        <attribute name="action">win.open-project</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Vorlage laden…</attribute>
        <attribute name="action">win.load-template</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Vorlage speichern unter…</attribute>
        <attribute name="action">win.save-template</attribute>
      </item>
    </section>
  </menu>
  <menu id="zoom_menu">
    <item>
      <attribute name="label" translatable="yes">An Fenster anpassen</attribute>
      <attribute name="action">win.zoom-fit</attribute>
      <attribute name="accel">&lt;Ctrl&gt;0</attribute>
    </item>
    <item>
      <attribute name="label" translatable="yes">100 %</attribute>
      <attribute name="action">win.zoom-100</attribute>
      <attribute name="accel">&lt;Ctrl&gt;1</attribute>
    </item>
    <item>
      <attribute name="label" translatable="yes">Vergrößern</attribute>
      <attribute name="action">win.zoom-in</attribute>
      <attribute name="accel">&lt;Ctrl&gt;plus</attribute>
    </item>
    <item>
      <attribute name="label" translatable="yes">Verkleinern</attribute>
      <attribute name="action">win.zoom-out</attribute>
      <attribute name="accel">&lt;Ctrl&gt;minus</attribute>
    </item>
  </menu>
  <menu id="primary_menu">
    <item>
      <attribute name="label" translatable="yes">Einstellungen…</attribute>
      <attribute name="action">app.preferences</attribute>
      <attribute name="accel">&lt;Ctrl&gt;comma</attribute>
    </item>
  </menu>
</interface>
