<?xml version="1.0" encoding="UTF-8"?>
<interface domain="screenforge">
  <template class="ScreenForgeWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="yes">ScreenForge</property>
    <property name="default-width">1200</property>
    <property name="default-height">760</property>
    <property name="width-request">360</property>
    <property name="height-request">400</property>
    <!-- Narrow windows: the sidebar becomes an overlay that starts hidden,
         so the canvas keeps the full width. -->
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 760sp</condition>
        <setter object="split_view" property="collapsed">True</setter>
        <setter object="split_view" property="show-sidebar">False</setter>
      </object>
    </child>
    <property name="content">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <child type="start">
              <object class="GtkMenuButton" id="add_menu_button">
                <property name="icon-name">list-add-symbolic</property>
                <property name="tooltip-text" translatable="yes">Add</property>
                <property name="menu-model">add_menu</property>
              </object>
            </child>
            <child type="start">
              <object class="GtkButton" id="android_import_button">
                <property name="icon-name">phone-symbolic</property>
                <property name="tooltip-text" translatable="yes">Import from Android Device</property>
                <property name="action-name">win.import-android</property>
                <property name="sensitive">false</property>
              </object>
            </child>
            <child type="start">
              <object class="GtkButton" id="undo_button">
                <property name="icon-name">edit-undo-symbolic</property>
                <property name="tooltip-text" translatable="yes">Undo (Ctrl+Z)</property>
                <property name="action-name">win.undo</property>
              </object>
            </child>
            <child type="start">
              <object class="GtkButton" id="redo_button">
                <property name="icon-name">edit-redo-symbolic</property>
                <property name="tooltip-text" translatable="yes">Redo (Ctrl+Shift+Z)</property>
                <property name="action-name">win.redo</property>
              </object>
            </child>
            <property name="title-widget">
              <object class="AdwWindowTitle" id="window_title">
                <property name="title" translatable="yes">ScreenForge</property>
              </object>
            </property>
            <!-- "end" children are packed right to left: menu, export,
                 sidebar toggle, presets appear as presets | sidebar |
                 Exportieren | menu on screen. -->
            <child type="end">
              <object class="GtkMenuButton" id="primary_menu_button">
                <property name="icon-name">open-menu-symbolic</property>
                <property name="tooltip-text" translatable="yes">Main Menu</property>
                <property name="menu-model">primary_menu</property>
                <property name="primary">true</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton" id="export_button">
                <property name="label" translatable="yes">Export</property>
                <property name="action-name">win.export</property>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>
            <child type="end">
              <object class="GtkToggleButton" id="sidebar_toggle_button">
                <property name="icon-name">sidebar-show-right-symbolic</property>
                <property name="tooltip-text" translatable="yes">Toggle Sidebar (F9)</property>
              </object>
            </child>
            <child type="end">
              <!-- Popover content is built in presets.rs (a persisted,
                   editable list can't be a static menu model). -->
              <object class="GtkMenuButton" id="presets_menu_button">
                <property name="icon-name">user-bookmarks-symbolic</property>
                <property name="tooltip-text" translatable="yes">Presets</property>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="AdwToastOverlay" id="toast_overlay">
            <property name="child">
              <object class="AdwOverlaySplitView" id="split_view">
                <property name="sidebar-position">end</property>
                <property name="sidebar-width-fraction">0.3</property>
                <property name="min-sidebar-width">320</property>
                <property name="max-sidebar-width">400</property>
                <property name="sidebar">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="AdwInlineViewSwitcher">
                        <property name="stack">sidebar_stack</property>
                        <property name="display-mode">labels</property>
                        <property name="can-shrink">false</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>
                        <property name="margin-top">8</property>
                        <property name="margin-bottom">2</property>
                        <style>
                          <class name="flat"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="AdwViewStack" id="sidebar_stack">
                        <property name="vexpand">true</property>
                <child>
                  <object class="AdwViewStackPage">
                    <property name="name">layout</property>
                    <property name="title" translatable="yes">Layout</property>
                    <property name="icon-name">view-grid-symbolic</property>
                    <property name="child">
                      <object class="AdwPreferencesPage" id="layout_page">
                            <child>
                              <object class="AdwPreferencesGroup">
                                <property name="title" translatable="yes">Layout</property>
                                <child>
                                  <object class="AdwToggleGroup" id="layout_mode_toggle">
                                    <property name="homogeneous">true</property>
                                    <child>
                                      <object class="AdwToggle">
                                        <property name="name">horizontal</property>
                                        <property name="icon-name">sf-layout-horizontal-symbolic</property>
                                        <property name="tooltip" translatable="yes">Horizontal</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwToggle">
                                        <property name="name">vertical</property>
                                        <property name="icon-name">sf-layout-vertical-symbolic</property>
                                        <property name="tooltip" translatable="yes">Vertical</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwToggle">
                                        <property name="name">grid</property>
                                        <property name="icon-name">sf-layout-grid-symbolic</property>
                                        <property name="tooltip" translatable="yes">Grid</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwToggle">
                                        <property name="name">free</property>
                                        <property name="icon-name">sf-layout-free-symbolic</property>
                                        <property name="tooltip" translatable="yes">Free — place screenshots with the mouse</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwPreferencesGroup">
                                <property name="title" translatable="yes">Spacing and Margins</property>
                                <child>
                                  <object class="AdwSpinRow" id="spacing_row">
                                    <property name="title" translatable="yes">Spacing</property>
                                    <property name="subtitle" translatable="yes">Between the screenshots, in pixels</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">500</property>
                                        <property name="step-increment">4</property>
                                        <property name="page-increment">20</property>
                                        <property name="value">24</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwSpinRow" id="margin_x_row">
                                    <property name="title" translatable="yes">Horizontal Margin</property>
                                    <property name="subtitle" translatable="yes">Left/right around the composition, in pixels</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">500</property>
                                        <property name="step-increment">4</property>
                                        <property name="page-increment">20</property>
                                        <property name="value">48</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwSpinRow" id="margin_y_row">
                                    <property name="title" translatable="yes">Vertical Margin</property>
                                    <property name="subtitle" translatable="yes">Above/below the composition, in pixels</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">500</property>
                                        <property name="step-increment">4</property>
                                        <property name="page-increment">20</property>
                                        <property name="value">48</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwPreferencesGroup" id="alignment_group">
                                <property name="title" translatable="yes">Alignment</property>
                                <property name="description" translatable="yes">For at least 2 selected screenshots in the free layout</property>
                                <property name="visible">false</property>
                                <child>
                                  <object class="AdwActionRow">
                                    <property name="title" translatable="yes">Horizontal</property>
                                    <child type="suffix">
                                      <object class="GtkBox">
                                        <property name="valign">center</property>
                                        <style>
                                          <class name="linked"/>
                                        </style>
                                        <child>
                                          <object class="GtkButton" id="align_left_button">
                                            <property name="icon-name">sf-align-left-symbolic</property>
                                            <property name="tooltip-text" translatable="yes">Align Left Edges</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton" id="align_center_h_button">
                                            <property name="icon-name">sf-align-center-h-symbolic</property>
                                            <property name="tooltip-text" translatable="yes">Center Horizontally</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton" id="align_right_button">
                                            <property name="icon-name">sf-align-right-symbolic</property>
                                            <property name="tooltip-text" translatable="yes">Align Right Edges</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow">
                                    <property name="title" translatable="yes">Vertical</property>
                                    <child type="suffix">
                                      <object class="GtkBox">
                                        <property name="valign">center</property>
                                        <style>
                                          <class name="linked"/>
                                        </style>
                                        <child>
                                          <object class="GtkButton" id="align_top_button">
                                            <property name="icon-name">sf-align-top-symbolic</property>
                                            <property name="tooltip-text" translatable="yes">Align Top Edges</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton" id="align_center_v_button">
                                            <property name="icon-name">sf-align-center-v-symbolic</property>
                                            <property name="tooltip-text" translatable="yes">Center Vertically</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton" id="align_bottom_button">
                                            <property name="icon-name">sf-align-bottom-symbolic</property>
                                            <property name="tooltip-text" translatable="yes">Align Bottom Edges</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwButtonRow" id="balance_row">
                                    <property name="title" translatable="yes">Distribute Evenly</property>
                                    <property name="start-icon-name">sf-layout-horizontal-symbolic</property>
                                    <property name="tooltip-text" translatable="yes">All screenshots in one row with equal gaps, centered on one line</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwViewStackPage">
                    <property name="name">background</property>
                    <property name="title" translatable="yes">Background</property>
                    <property name="icon-name">image-x-generic-symbolic</property>
                    <property name="child">
                      <object class="AdwPreferencesPage" id="background_page">
                            <child>
                              <object class="AdwPreferencesGroup" id="background_group">
                                <property name="title" translatable="yes">Background</property>
                                <child>
                                  <object class="AdwComboRow" id="background_type_row">
                                    <property name="title" translatable="yes">Type</property>
                                    <property name="model">
                                      <object class="GtkStringList">
                                        <items>
                                          <item translatable="yes">Solid Color</item>
                                          <item translatable="yes">Linear Gradient</item>
                                          <item translatable="yes">Radial Gradient</item>
                                          <item translatable="yes">Image</item>
                                          <item translatable="yes">Generated</item>
                                  <item translatable="yes">Screenshot (Blurred)</item>
                                        </items>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow" id="background_color1_row">
                                    <property name="title" translatable="yes">Color 1</property>
                                    <child type="suffix">
                                      <object class="GtkColorDialogButton" id="background_color_button">
                                        <property name="valign">center</property>
                                        <property name="dialog">
                                          <object class="GtkColorDialog"/>
                                        </property>
                                      </object>
                                    </child>
                                    <child type="suffix">
                                      <object class="GtkButton" id="background_eyedropper_button">
                                        <property name="valign">center</property>
                                        <property name="icon-name">color-select-symbolic</property>
                                        <property name="tooltip-text" translatable="yes">Pick a color from a screenshot</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow" id="gradient_color2_row">
                                    <property name="title" translatable="yes">Color 2</property>
                                    <property name="visible">false</property>
                                    <child type="suffix">
                                      <object class="GtkColorDialogButton" id="gradient_color2_button">
                                        <property name="valign">center</property>
                                        <property name="dialog">
                                          <object class="GtkColorDialog"/>
                                        </property>
                                      </object>
                                    </child>
                                    <child type="suffix">
                                      <object class="GtkButton" id="gradient_color2_eyedropper_button">
                                        <property name="valign">center</property>
                                        <property name="icon-name">color-select-symbolic</property>
                                        <property name="tooltip-text" translatable="yes">Pick a color from a screenshot</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwSpinRow" id="gradient_angle_row">
                                    <property name="title" translatable="yes">Angle</property>
                                    <property name="subtitle" translatable="yes">In degrees</property>
                                    <property name="visible">false</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">360</property>
                                        <property name="step-increment">15</property>
                                        <property name="page-increment">45</property>
                                        <property name="value">90</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow" id="gradient_auto_colors_row">
                                    <property name="title" translatable="yes">Automatic Colors</property>
                                    <property name="subtitle" translatable="yes">Suggested from the imported screenshots — click again for another suggestion</property>
                                    <property name="visible">false</property>
                                    <child type="suffix">
                                      <object class="GtkButton" id="gradient_generate_button">
                                        <property name="valign">center</property>
                                        <property name="label" translatable="yes">Generate</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow" id="background_image_row">
                                    <property name="title" translatable="yes">Image File</property>
                                    <property name="subtitle" translatable="yes">No image selected</property>
                                    <property name="visible">false</property>
                                    <child type="suffix">
                                      <object class="GtkButton" id="background_image_button">
                                        <property name="valign">center</property>
                                        <property name="label" translatable="yes">Choose…</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwComboRow" id="background_image_fit_row">
                                    <property name="title" translatable="yes">Image Fit</property>
                                    <property name="visible">false</property>
                                    <property name="model">
                                      <object class="GtkStringList">
                                        <items>
                                          <item translatable="yes">Fill (crop)</item>
                                          <item translatable="yes">Fit</item>
                                          <item translatable="yes">Stretch</item>
                                          <item translatable="yes">Tile</item>
                                        </items>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwSpinRow" id="background_image_opacity_row">
                                    <property name="title" translatable="yes">Opacity</property>
                                    <property name="subtitle" translatable="yes">In percent</property>
                                    <property name="visible">false</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">100</property>
                                        <property name="step-increment">5</property>
                                        <property name="page-increment">20</property>
                                        <property name="value">100</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwSpinRow" id="blurred_blur_row">
                                    <property name="title" translatable="yes">Blur Amount</property>
                                    <property name="subtitle" translatable="yes">In percent — the first visible screenshot as background</property>
                                    <property name="visible">false</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">100</property>
                                        <property name="step-increment">5</property>
                                        <property name="page-increment">20</property>
                                        <property name="value">60</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwSpinRow" id="blurred_brightness_row">
                                    <property name="title" translatable="yes">Brightness</property>
                                    <property name="subtitle" translatable="yes">In percent — negative darkens, positive lightens</property>
                                    <property name="visible">false</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">-100</property>
                                        <property name="upper">100</property>
                                        <property name="step-increment">5</property>
                                        <property name="page-increment">20</property>
                                        <property name="value">-15</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwComboRow" id="generator_style_row">
                                    <property name="title" translatable="yes">Style</property>
                                    <property name="visible">false</property>
                                    <property name="model">
                                      <object class="GtkStringList">
                                        <items>
                                          <item translatable="yes">Layers</item>
                                          <item translatable="yes">Arcs</item>
                                          <item translatable="yes">Ribbons</item>
                                          <item translatable="yes">Planes</item>
                                          <item translatable="yes">Lines</item>
                                          <item translatable="yes">Mist</item>
                                          <item translatable="yes">Waves (Classic)</item>
                                        </items>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwComboRow" id="generator_color_strategy_row">
                                    <property name="title" translatable="yes">Colors</property>
                                    <property name="visible">false</property>
                                    <property name="model">
                                      <object class="GtkStringList">
                                        <items>
                                          <item translatable="yes">Manual</item>
                                          <item translatable="yes">From Screenshots</item>
                                          <item translatable="yes">Black and White</item>
                                          <item translatable="yes">Random</item>
                                        </items>
                                      </object>
                                    </property>
                                    <!-- Index 3 ("Zufällig") — the default
                                         generation mode (spec: "Zufällig soll zum
                                         Default-Modus für generierte Hintergründe
                                         werden"). Must come *after* `model` above:
                                         GtkBuilder applies properties in document
                                         order, and `selected` against a still-empty
                                         model silently clamps to 0 regardless of
                                         what's set here — confirmed by hand after
                                         the first attempt (property listed before
                                         `model`) had no effect. `generate_background`
                                         in main.rs reads this row's *current*
                                         selection directly rather than deriving it
                                         from GeneratedBackground::new()'s own
                                         default, so that Rust-level default alone
                                         was never enough either — this property is
                                         what actually makes the very first switch
                                         to "Generiert" land on Random. Any real
                                         Generated background (loaded, undone, or
                                         already generated) overrides this via
                                         sync_generator_controls regardless, so it
                                         only matters before that ever happens. -->
                                    <property name="selected">3</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwComboRow" id="generator_mood_row">
                                    <property name="title" translatable="yes">Mood</property>
                                    <property name="subtitle" translatable="yes">Lightness of the generated colors</property>
                                    <property name="visible">false</property>
                                    <property name="model">
                                      <object class="GtkStringList">
                                        <items>
                                          <item translatable="yes">Vivid</item>
                                          <item translatable="yes">Light</item>
                                          <item translatable="yes">Dark</item>
                                        </items>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow" id="generator_manual_color_row_1">
                                    <property name="title" translatable="yes">Color 1</property>
                                    <property name="visible">false</property>
                                    <child type="suffix">
                                      <object class="GtkColorDialogButton" id="generator_manual_color_button_1">
                                        <property name="valign">center</property>
                                        <property name="dialog">
                                          <object class="GtkColorDialog"/>
                                        </property>
                                      </object>
                                    </child>
                                    <child type="suffix">
                                      <object class="GtkButton" id="generator_manual_eyedropper_button_1">
                                        <property name="valign">center</property>
                                        <property name="icon-name">color-select-symbolic</property>
                                        <property name="tooltip-text" translatable="yes">Pick a color from a screenshot</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow" id="generator_manual_color_row_2">
                                    <property name="title" translatable="yes">Color 2</property>
                                    <property name="visible">false</property>
                                    <child type="suffix">
                                      <object class="GtkColorDialogButton" id="generator_manual_color_button_2">
                                        <property name="valign">center</property>
                                        <property name="dialog">
                                          <object class="GtkColorDialog"/>
                                        </property>
                                      </object>
                                    </child>
                                    <child type="suffix">
                                      <object class="GtkButton" id="generator_manual_eyedropper_button_2">
                                        <property name="valign">center</property>
                                        <property name="icon-name">color-select-symbolic</property>
                                        <property name="tooltip-text" translatable="yes">Pick a color from a screenshot</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow" id="generator_manual_color_row_3">
                                    <property name="title" translatable="yes">Color 3</property>
                                    <property name="visible">false</property>
                                    <child type="suffix">
                                      <object class="GtkColorDialogButton" id="generator_manual_color_button_3">
                                        <property name="valign">center</property>
                                        <property name="dialog">
                                          <object class="GtkColorDialog"/>
                                        </property>
                                      </object>
                                    </child>
                                    <child type="suffix">
                                      <object class="GtkButton" id="generator_manual_eyedropper_button_3">
                                        <property name="valign">center</property>
                                        <property name="icon-name">color-select-symbolic</property>
                                        <property name="tooltip-text" translatable="yes">Pick a color from a screenshot</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow" id="generator_manual_color_row_4">
                                    <property name="title" translatable="yes">Color 4</property>
                                    <property name="visible">false</property>
                                    <child type="suffix">
                                      <object class="GtkColorDialogButton" id="generator_manual_color_button_4">
                                        <property name="valign">center</property>
                                        <property name="dialog">
                                          <object class="GtkColorDialog"/>
                                        </property>
                                      </object>
                                    </child>
                                    <child type="suffix">
                                      <object class="GtkButton" id="generator_manual_eyedropper_button_4">
                                        <property name="valign">center</property>
                                        <property name="icon-name">color-select-symbolic</property>
                                        <property name="tooltip-text" translatable="yes">Pick a color from a screenshot</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwSwitchRow" id="generator_adapt_row">
                                    <property name="title" translatable="yes">Adapt to Screenshots</property>
                                    <property name="subtitle" translatable="yes">Colors and placement take the screenshots into account</property>
                                    <property name="visible">false</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwSpinRow" id="generator_inverse_contrast_row">
                                    <property name="title" translatable="yes">Inverted Contrast</property>
                                    <property name="subtitle" translatable="yes">In percent — only for "From Screenshots": higher looks more opposed/complementary instead of similar</property>
                                    <property name="visible">false</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">100</property>
                                        <property name="step-increment">5</property>
                                        <property name="page-increment">20</property>
                                        <property name="value">50</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwSpinRow" id="generator_corner_bias_row">
                                    <property name="title" translatable="yes">Focus</property>
                                    <property name="subtitle" translatable="yes">In percent — 0 % wave bands, 100 % corner arcs</property>
                                    <property name="visible">false</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">100</property>
                                        <property name="step-increment">5</property>
                                        <property name="page-increment">20</property>
                                        <property name="value">50</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwSpinRow" id="generator_scale_row">
                                    <property name="title" translatable="yes">Scale</property>
                                    <property name="subtitle" translatable="yes">In percent — enlarges or shrinks the pattern</property>
                                    <property name="visible">false</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">40</property>
                                        <property name="upper">250</property>
                                        <property name="step-increment">10</property>
                                        <property name="page-increment">50</property>
                                        <property name="value">100</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwSpinRow" id="generator_contrast_row">
                                    <property name="title" translatable="yes">Contrast</property>
                                    <property name="visible">false</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">100</property>
                                        <property name="step-increment">5</property>
                                        <property name="page-increment">20</property>
                                        <property name="value">50</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwSpinRow" id="generator_grain_row">
                                    <property name="title" translatable="yes">Grain</property>
                                    <property name="subtitle" translatable="yes">In percent — fine noise against color banding</property>
                                    <property name="visible">false</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">100</property>
                                        <property name="step-increment">5</property>
                                        <property name="page-increment">20</property>
                                        <property name="value">35</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwSpinRow" id="generator_seed_row">
                                    <property name="title" translatable="yes">Seed</property>
                                    <property name="subtitle" translatable="yes">For reproducible results</property>
                                    <property name="visible">false</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">999999999</property>
                                        <property name="step-increment">1</property>
                                        <property name="page-increment">1000</property>
                                        <property name="value">1</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwButtonRow" id="generator_generate_row">
                                    <property name="title" translatable="yes">Regenerate</property>
                                    <property name="start-icon-name">view-refresh-symbolic</property>
                                    <property name="visible">false</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwPreferencesGroup" id="variants_group">
                                <property name="title" translatable="yes">Variants</property>
                                <property name="description" translatable="yes">Click a variant to use it</property>
                                <property name="visible">false</property>
                                <child>
                                  <object class="GtkFlowBox" id="variants_flow">
                                    <property name="selection-mode">none</property>
                                    <property name="homogeneous">true</property>
                                    <property name="min-children-per-line">3</property>
                                    <property name="max-children-per-line">3</property>
                                    <property name="column-spacing">6</property>
                                    <property name="row-spacing">6</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwPreferencesGroup" id="variants_actions_group">
                                <property name="visible">false</property>
                                <child>
                                  <object class="AdwSwitchRow" id="variants_mix_row">
                                    <property name="title" translatable="yes">Mix Styles</property>
                                    <property name="subtitle" translatable="yes">Variants from all styles instead of only the chosen one</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwButtonRow" id="variants_reroll_row">
                                    <property name="title" translatable="yes">New Variants</property>
                                    <property name="start-icon-name">view-refresh-symbolic</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwButtonRow" id="variants_studio_row">
                                    <property name="title" translatable="yes">More Variants…</property>
                                    <property name="end-icon-name">go-next-symbolic</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwViewStackPage">
                    <property name="name">style</property>
                    <property name="title" translatable="yes">Style</property>
                    <property name="icon-name">applications-graphics-symbolic</property>
                    <property name="child">
                      <object class="AdwPreferencesPage" id="style_page">
                            <child>
                              <object class="AdwPreferencesGroup">
                                <property name="title" translatable="yes">Effects</property>
                                <child>
                                  <object class="AdwComboRow" id="shadow_row">
                                    <property name="title" translatable="yes">Shadow</property>
                                    <property name="model">
                                      <object class="GtkStringList">
                                        <items>
                                          <item translatable="yes">No Shadow</item>
                                          <item translatable="yes">Subtle</item>
                                          <item translatable="yes">Standard</item>
                                          <item translatable="yes">Strong</item>
                                          <item translatable="yes">Floating</item>
                                          <item translatable="yes">Custom</item>
                                        </items>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwSpinRow" id="shadow_angle_row">
                                    <property name="title" translatable="yes">Shadow Angle</property>
                                    <property name="subtitle" translatable="yes">Direction the shadow falls, in degrees</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">360</property>
                                        <property name="step-increment">5</property>
                                        <property name="page-increment">45</property>
                                        <property name="value">90</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwSpinRow" id="shadow_distance_row">
                                    <property name="title" translatable="yes">Shadow Distance</property>
                                    <property name="subtitle" translatable="yes">Length of the shadow, in pixels</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">300</property>
                                        <property name="step-increment">2</property>
                                        <property name="page-increment">20</property>
                                        <property name="value">6</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwSpinRow" id="shadow_blur_row">
                                    <property name="title" translatable="yes">Softness</property>
                                    <property name="subtitle" translatable="yes">Softness of the shadow, in pixels</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">150</property>
                                        <property name="step-increment">2</property>
                                        <property name="page-increment">10</property>
                                        <property name="value">16</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwSpinRow" id="corner_radius_row">
                                    <property name="title" translatable="yes">Corner Radius</property>
                                    <property name="subtitle" translatable="yes">In pixels</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">200</property>
                                        <property name="step-increment">2</property>
                                        <property name="page-increment">10</property>
                                        <property name="value">0</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                              </object>
                            </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwViewStackPage">
                    <property name="name">text</property>
                    <property name="title" translatable="yes">Text</property>
                    <property name="icon-name">insert-text-symbolic</property>
                    <property name="child">
                      <object class="AdwPreferencesPage" id="text_page">
                            <child>
                              <object class="AdwPreferencesGroup" id="label_group">
                                <property name="title" translatable="yes">Label</property>
                                <property name="description" translatable="yes">For the selected screenshot</property>
                                <property name="visible">false</property>
                                <child>
                                  <object class="AdwSwitchRow" id="label_enabled_row">
                                    <property name="title" translatable="yes">Show Label</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox" id="label_content_box">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">6</property>
                                    <property name="margin-top">12</property>
                                    <property name="margin-bottom">12</property>
                                    <property name="margin-start">12</property>
                                    <property name="margin-end">12</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Text</property>
                                        <property name="halign">start</property>
                                        <style>
                                          <class name="caption-heading"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkScrolledWindow">
                                        <property name="hscrollbar-policy">never</property>
                                        <property name="min-content-height">64</property>
                                        <property name="max-content-height">120</property>
                                        <style>
                                          <class name="card"/>
                                        </style>
                                        <child>
                                          <object class="GtkTextView" id="label_content_view">
                                            <property name="sensitive">false</property>
                                            <property name="wrap-mode">word-char</property>
                                            <property name="top-margin">8</property>
                                            <property name="bottom-margin">8</property>
                                            <property name="left-margin">8</property>
                                            <property name="right-margin">8</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwPreferencesGroup" id="callouts_group">
                                <property name="title" translatable="yes">Callouts</property>
                                <property name="description" translatable="yes">For the selected screenshot</property>
                                <property name="visible">false</property>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">12</property>
                                    <child>
                                      <object class="GtkListBox" id="callouts_list_box">
                                        <property name="selection-mode">none</property>
                                        <property name="visible">false</property>
                                        <style>
                                          <class name="boxed-list"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkButton" id="add_callout_button">
                                        <property name="label" translatable="yes">+ Add Callout</property>
                                        <property name="halign">start</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwViewStackPage">
                    <property name="name">export</property>
                    <property name="title" translatable="yes" context="sidebar tab">Export</property>
                    <property name="icon-name">document-save-symbolic</property>
                    <property name="child">
                      <object class="AdwPreferencesPage" id="export_page">
                            <child>
                              <object class="AdwPreferencesGroup" id="export_group">
                                <property name="title" translatable="yes">Export</property>
                                <child>
                                  <object class="AdwSpinRow" id="export_width_row">
                                    <property name="title" translatable="yes">Target Width</property>
                                    <property name="subtitle" translatable="yes">The canvas fits the images automatically; this only scales the output size</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">100</property>
                                        <property name="upper">8000</property>
                                        <property name="step-increment">10</property>
                                        <property name="page-increment">100</property>
                                        <property name="value">1920</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwSpinRow" id="export_height_row">
                                    <property name="title" translatable="yes">Height</property>
                                    <property name="subtitle" translatable="yes">Automatic, keeps the aspect ratio</property>
                                    <property name="sensitive">false</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">1</property>
                                        <property name="upper">100000</property>
                                        <property name="step-increment">10</property>
                                        <property name="page-increment">100</property>
                                        <property name="value">1080</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwComboRow" id="export_format_row">
                                    <property name="title" translatable="yes">Format</property>
                                    <property name="model">
                                      <object class="GtkStringList">
                                        <items>
                                          <item>PNG</item>
                                          <item>JPEG</item>
                                          <item>WebP</item>
                                          <item>AVIF</item>
                                  <item>PDF</item>
                                        </items>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwSpinRow" id="export_quality_row">
                                    <property name="title" translatable="yes">Quality</property>
                                    <property name="subtitle" translatable="yes">Only for JPEG/WebP/AVIF</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">1</property>
                                        <property name="upper">100</property>
                                        <property name="step-increment">5</property>
                                        <property name="page-increment">10</property>
                                        <property name="value">90</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                              </object>
                            </child>
                      </object>
                    </property>
                  </object>
                </child>
                      </object>
                    </child>
                  </object>
                </property>
                <property name="content">
                  <object class="GtkOverlay" id="canvas_overlay">
                    <property name="child">
                      <object class="GtkScrolledWindow" id="canvas_scroller">
                        <property name="hexpand">true</property>
                        <property name="vexpand">true</property>
                        <child>
                          <object class="ScreenForgeCanvas" id="canvas">
                            <property name="hexpand">true</property>
                            <property name="vexpand">true</property>
                          </object>
                        </child>
                      </object>
                    </property>
                    <child type="overlay">
                      <object class="AdwStatusPage" id="empty_state">
                        <property name="icon-name">de.christophlangner.ScreenForge-symbolic</property>
                        <property name="title" translatable="yes">Add Screenshots</property>
                        <property name="description" translatable="yes">Drag images here, paste them with Ctrl+V or fetch them from an Android device</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="halign">center</property>
                            <property name="spacing">12</property>
                            <child>
                              <object class="GtkButton">
                                <property name="label" translatable="yes">Open Images…</property>
                                <property name="action-name">win.open</property>
                                <style>
                                  <class name="pill"/>
                                  <class name="suggested-action"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton">
                                <property name="label" translatable="yes">Open Project…</property>
                                <property name="action-name">win.open-project</property>
                                <style>
                                  <class name="pill"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child type="overlay">
                      <object class="GtkBox" id="canvas_toolbar">
                        <property name="halign">end</property>
                        <property name="valign">end</property>
                        <property name="margin-end">12</property>
                        <property name="margin-bottom">12</property>
                        <property name="spacing">2</property>
                        <style>
                          <class name="toolbar"/>
                          <class name="osd"/>
                          <class name="canvas-toolbar"/>
                        </style>
                        <child>
                          <object class="GtkButton">
                            <property name="icon-name">zoom-out-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Zoom Out (Ctrl+−)</property>
                            <property name="action-name">win.zoom-out</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkMenuButton" id="zoom_menu_button">
                            <property name="label" translatable="yes">Fit</property>
                            <property name="tooltip-text" translatable="yes">Zoom</property>
                            <property name="menu-model">zoom_menu</property>
                            <property name="direction">up</property>
                            <property name="always-show-arrow">false</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton">
                            <property name="icon-name">zoom-in-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Zoom In (Ctrl++)</property>
                            <property name="action-name">win.zoom-in</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkSeparator"/>
                        </child>
                        <child>
                          <object class="GtkButton" id="drag_out_button">
                            <property name="icon-name">document-send-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Drag out the image — into a browser, file manager or chat</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton">
                            <property name="icon-name">edit-copy-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Copy Image to Clipboard (Ctrl+Shift+C)</property>
                            <property name="action-name">win.copy-image</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkSeparator"/>
                        </child>
                        <child>
                          <object class="GtkToggleButton" id="hide_screenshots_button">
                            <property name="icon-name">view-conceal-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Hide the screenshots temporarily to judge the background</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
  <menu id="add_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">Open Images…</attribute>
        <attribute name="action">win.open</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Paste from Clipboard</attribute>
        <attribute name="action">win.paste</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Take Screenshot…</attribute>
        <attribute name="action">win.take-screenshot</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Open Project…</attribute>
        <attribute name="action">win.open-project</attribute>
      </item>
    </section>
  </menu>
  <menu id="zoom_menu">
    <item>
      <attribute name="label" translatable="yes">Fit to Window</attribute>
      <attribute name="action">win.zoom-fit</attribute>
      <attribute name="accel">&lt;Ctrl&gt;0</attribute>
    </item>
    <item>
      <attribute name="label" translatable="yes">100 %</attribute>
      <attribute name="action">win.zoom-100</attribute>
      <attribute name="accel">&lt;Ctrl&gt;1</attribute>
    </item>
    <item>
      <attribute name="label" translatable="yes">Zoom In</attribute>
      <attribute name="action">win.zoom-in</attribute>
      <attribute name="accel">&lt;Ctrl&gt;plus</attribute>
    </item>
    <item>
      <attribute name="label" translatable="yes">Zoom Out</attribute>
      <attribute name="action">win.zoom-out</attribute>
      <attribute name="accel">&lt;Ctrl&gt;minus</attribute>
    </item>
  </menu>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">Open Project…</attribute>
        <attribute name="action">win.open-project</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Save</attribute>
        <attribute name="action">win.save</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Save As…</attribute>
        <attribute name="action">win.save-as</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Preferences</attribute>
        <attribute name="action">app.preferences</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Keyboard Shortcuts</attribute>
        <attribute name="action">app.shortcuts</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">About ScreenForge</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
</interface>
