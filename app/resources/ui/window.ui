                            </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwViewStackPage">
                    <property name="name">style</property>
                    <property name="title" translatable="yes">Stil</property>
                    <property name="icon-name">applications-graphics-symbolic</property>
                    <property name="child">
                      <object class="AdwPreferencesPage" id="style_page">
                            <child>
                              <object class="AdwPreferencesGroup">
                                <property name="title" translatable="yes">Effekte</property>
                                <child>
                                  <object class="AdwComboRow" id="shadow_row">
                                    <property name="title" translatable="yes">Schatten</property>
                                    <property name="model">
                                      <object class="GtkStringList">
                                        <items>
                                          <item translatable="yes">Kein Schatten</item>
                                          <item translatable="yes">Subtil</item>
                                          <item translatable="yes">Standard</item>
                                          <item translatable="yes">Stark</item>
                                          <item translatable="yes">Floating</item>
                                          <item translatable="yes">Angepasst</item>
                                        </items>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwSpinRow" id="shadow_angle_row">
                                    <property name="title" translatable="yes">Schatten-Winkel</property>
                                    <property name="subtitle" translatable="yes">Richtung des Schattenwurfs, in Grad</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">360</property>
                                        <property name="step-increment">5</property>
                                        <property name="page-increment">45</property>
                                        <property name="value">90</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwSpinRow" id="shadow_distance_row">
                                    <property name="title" translatable="yes">Schatten-Distanz</property>
                                    <property name="subtitle" translatable="yes">Länge des Schattenwurfs, in Pixeln</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">300</property>
                                        <property name="step-increment">2</property>
                                        <property name="page-increment">20</property>
                                        <property name="value">6</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwSpinRow" id="shadow_blur_row">
                                    <property name="title" translatable="yes">Weichzeichner</property>
                                    <property name="subtitle" translatable="yes">Unschärfe des Schattens, in Pixeln</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">150</property>
                                        <property name="step-increment">2</property>
                                        <property name="page-increment">10</property>
                                        <property name="value">16</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwSpinRow" id="corner_radius_row">
                                    <property name="title" translatable="yes">Eckenradius</property>
                                    <property name="subtitle" translatable="yes">In Pixeln</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">200</property>
                                        <property name="step-increment">2</property>
                                        <property name="page-increment">10</property>
                                        <property name="value">0</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                              </object>
                            </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwViewStackPage">
                    <property name="name">text</property>
                    <property name="title" translatable="yes">Text</property>
                    <property name="icon-name">insert-text-symbolic</property>
                    <property name="child">
                      <object class="AdwPreferencesPage" id="text_page">
                            <child>
                              <object class="AdwPreferencesGroup" id="label_group">
                                <property name="title" translatable="yes">Label</property>
                                <property name="description" translatable="yes">Für den ausgewählten Screenshot</property>
                                <property name="visible">false</property>
                                <child>
                                  <object class="AdwSwitchRow" id="label_enabled_row">
                                    <property name="title" translatable="yes">Label anzeigen</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox" id="label_content_box">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">6</property>
                                    <property name="margin-top">12</property>
                                    <property name="margin-bottom">12</property>
                                    <property name="margin-start">12</property>
                                    <property name="margin-end">12</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Text</property>
                                        <property name="halign">start</property>
                                        <style>
                                          <class name="caption-heading"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkScrolledWindow">
                                        <property name="hscrollbar-policy">never</property>
                                        <property name="min-content-height">64</property>
                                        <property name="max-content-height">120</property>
                                        <style>
                                          <class name="card"/>
                                        </style>
                                        <child>
                                          <object class="GtkTextView" id="label_content_view">
                                            <property name="sensitive">false</property>
                                            <property name="wrap-mode">word-char</property>
                                            <property name="top-margin">8</property>
                                            <property name="bottom-margin">8</property>
                                            <property name="left-margin">8</property>
                                            <property name="right-margin">8</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwPreferencesGroup" id="callouts_group">
                                <property name="title" translatable="yes">Callouts</property>
                                <property name="description" translatable="yes">Für den ausgewählten Screenshot</property>
                                <property name="visible">false</property>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">12</property>
                                    <child>
                                      <object class="GtkListBox" id="callouts_list_box">
                                        <property name="selection-mode">none</property>
                                        <property name="visible">false</property>
                                        <style>
                                          <class name="boxed-list"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkButton" id="add_callout_button">
                                        <property name="label" translatable="yes">+ Callout hinzufügen</property>
                                        <property name="halign">start</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwViewStackPage">
                    <property name="name">export</property>
                    <property name="title" translatable="yes">Export</property>
                    <property name="icon-name">document-save-symbolic</property>
                    <property name="child">
                      <object class="AdwPreferencesPage" id="export_page">
                            <child>
                              <object class="AdwPreferencesGroup" id="export_group">
                                <property name="title" translatable="yes">Export</property>
                                <child>
                                  <object class="AdwSpinRow" id="export_width_row">
                                    <property name="title" translatable="yes">Zielbreite</property>
                                    <property name="subtitle" translatable="yes">Die Arbeitsfläche passt sich automatisch den Bildern an; hier wird nur die Ausgabegröße skaliert</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">100</property>
                                        <property name="upper">8000</property>
                                        <property name="step-increment">10</property>
                                        <property name="page-increment">100</property>
                                        <property name="value">1920</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwSpinRow" id="export_height_row">
                                    <property name="title" translatable="yes">Höhe</property>
                                    <property name="subtitle" translatable="yes">Automatisch, behält das Seitenverhältnis bei</property>
                                    <property name="sensitive">false</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">1</property>
                                        <property name="upper">100000</property>
                                        <property name="step-increment">10</property>
                                        <property name="page-increment">100</property>
                                        <property name="value">1080</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwComboRow" id="export_format_row">
                                    <property name="title" translatable="yes">Format</property>
                                    <property name="model">
                                      <object class="GtkStringList">
                                        <items>
                                          <item>PNG</item>
                                          <item>JPEG</item>
                                          <item>WebP</item>
                                          <item>AVIF</item>
                                  <item>PDF</item>
                                        </items>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwSpinRow" id="export_quality_row">
                                    <property name="title" translatable="yes">Qualität</property>
                                    <property name="subtitle" translatable="yes">Nur für JPEG/WebP/AVIF</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">1</property>
                                        <property name="upper">100</property>
                                        <property name="step-increment">5</property>
                                        <property name="page-increment">10</property>
                                        <property name="value">90</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                              </object>
                            </child>
                      </object>
                    </property>
                  </object>
                </child>
                      </object>
                    </child>
                  </object>
                </property>
                <property name="content">
                  <object class="GtkOverlay" id="canvas_overlay">
                    <property name="child">
                      <object class="GtkScrolledWindow" id="canvas_scroller">
                        <property name="hexpand">true</property>
                        <property name="vexpand">true</property>
                        <child>
                          <object class="ScreenForgeCanvas" id="canvas">
                            <property name="hexpand">true</property>
                            <property name="vexpand">true</property>
                          </object>
                        </child>
                      </object>
                    </property>
                    <child type="overlay">
                      <object class="AdwStatusPage" id="empty_state">
                        <property name="icon-name">de.christophlangner.ScreenForge-symbolic</property>
                        <property name="title" translatable="yes">Screenshots hinzufügen</property>
                        <property name="description" translatable="yes">Bilder hierher ziehen, mit Strg+V einfügen oder vom Android-Gerät holen</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="halign">center</property>
                            <property name="spacing">12</property>
                            <child>
                              <object class="GtkButton">
                                <property name="label" translatable="yes">Bilder öffnen …</property>
                                <property name="action-name">win.open</property>
                                <style>
                                  <class name="pill"/>
                                  <class name="suggested-action"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton">
                                <property name="label" translatable="yes">Projekt öffnen …</property>
                                <property name="action-name">win.open-project</property>
                                <style>
                                  <class name="pill"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child type="overlay">
                      <object class="GtkBox" id="canvas_toolbar">
                        <property name="halign">end</property>
                        <property name="valign">end</property>
                        <property name="margin-end">12</property>
                        <property name="margin-bottom">12</property>
                        <property name="spacing">2</property>
                        <style>
                          <class name="toolbar"/>
                          <class name="osd"/>
                          <class name="canvas-toolbar"/>
                        </style>
                        <child>
                          <object class="GtkButton">
                            <property name="icon-name">zoom-out-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Verkleinern (Strg+−)</property>
                            <property name="action-name">win.zoom-out</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkMenuButton" id="zoom_menu_button">
                            <property name="label" translatable="yes">Einpassen</property>
                            <property name="tooltip-text" translatable="yes">Zoom</property>
                            <property name="menu-model">zoom_menu</property>
                            <property name="direction">up</property>
                            <property name="always-show-arrow">false</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton">
                            <property name="icon-name">zoom-in-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Vergrößern (Strg++)</property>
                            <property name="action-name">win.zoom-in</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkSeparator"/>
                        </child>
                        <child>
                          <object class="GtkButton" id="drag_out_button">
                            <property name="icon-name">document-send-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Bild herausziehen — in den Browser, Dateimanager oder Chat ziehen</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton">
                            <property name="icon-name">edit-copy-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Bild in die Zwischenablage kopieren (Strg+Umschalt+C)</property>
                            <property name="action-name">win.copy-image</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkSeparator"/>
                        </child>
                        <child>
                          <object class="GtkToggleButton" id="hide_screenshots_button">
                            <property name="icon-name">view-conceal-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Screenshots vorübergehend ausblenden, um den Hintergrund zu beurteilen</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
  <menu id="add_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">Bilder öffnen …</attribute>
        <attribute name="action">win.open</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Aus Zwischenablage einfügen</attribute>
        <attribute name="action">win.paste</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Bildschirmfoto aufnehmen …</attribute>
        <attribute name="action">win.take-screenshot</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Projekt öffnen …</attribute>
        <attribute name="action">win.open-project</attribute>
      </item>
    </section>
  </menu>
  <menu id="zoom_menu">
    <item>
      <attribute name="label" translatable="yes">An Fenster anpassen</attribute>
      <attribute name="action">win.zoom-fit</attribute>
      <attribute name="accel">&lt;Ctrl&gt;0</attribute>
    </item>
    <item>
      <attribute name="label" translatable="yes">100 %</attribute>
      <attribute name="action">win.zoom-100</attribute>
      <attribute name="accel">&lt;Ctrl&gt;1</attribute>
    </item>
    <item>
      <attribute name="label" translatable="yes">Vergrößern</attribute>
      <attribute name="action">win.zoom-in</attribute>
      <attribute name="accel">&lt;Ctrl&gt;plus</attribute>
    </item>
    <item>
      <attribute name="label" translatable="yes">Verkleinern</attribute>
      <attribute name="action">win.zoom-out</attribute>
      <attribute name="accel">&lt;Ctrl&gt;minus</attribute>
    </item>
  </menu>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">Projekt öffnen …</attribute>
        <attribute name="action">win.open-project</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Speichern</attribute>
        <attribute name="action">win.save</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Speichern unter …</attribute>
        <attribute name="action">win.save-as</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Einstellungen</attribute>
        <attribute name="action">app.preferences</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Tastenkürzel</attribute>
        <attribute name="action">app.shortcuts</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Info zu ScreenForge</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
</interface>
