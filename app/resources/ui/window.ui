                                <child>
                                  <object class="AdwSpinRow" id="generator_inverse_contrast_row">
                                    <property name="title" translatable="yes">Invertierter Kontrast</property>
                                    <property name="subtitle" translatable="yes">In Prozent — nur bei "Von Screenshots": höher wirkt stärker gegensätzlich/komplementär statt ähnlich</property>
                                    <property name="visible">false</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">100</property>
                                        <property name="step-increment">5</property>
                                        <property name="page-increment">20</property>
                                        <property name="value">50</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwSpinRow" id="generator_corner_bias_row">
                                    <property name="title" translatable="yes">Fokus</property>
                                    <property name="subtitle" translatable="yes">In Prozent — 0 % Wellenbänder, 100 % Eckbögen</property>
                                    <property name="visible">false</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">100</property>
                                        <property name="step-increment">5</property>
                                        <property name="page-increment">20</property>
                                        <property name="value">50</property>
